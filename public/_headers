# Cloudflare Workers static-asset headers.
#
# Everything served straight out of public/ defaulted to `max-age=0,
# must-revalidate`, so the fonts and every catalog image cost a round trip on
# each repeat visit. These names are stable, so give them a real lifetime.
#
# Note: adding this file turns OFF the platform's automatic year-long caching
# of hashed build output, so /assets/ has to be restated here or the JS and CSS
# bundles silently drop to must-revalidate. Their filenames carry a content
# hash, so immutable is exactly right for them.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted Geist. Swapping a face means a new filename, so this is safe to
# pin: see the @font-face note in app/globals.css.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Project media. Long, but deliberately not immutable — these do get replaced
# in place when the catalog is regenerated.
/projects/catalog/*
  Cache-Control: public, max-age=2592000

/rendering-code/*
  Cache-Control: public, max-age=2592000

/profile/*
  Cache-Control: public, max-age=604800

# Share card and icon: short enough that a fix propagates within a week.
/og.jpg
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800
